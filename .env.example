#  Nhost system env vars 
# Nhost provides these automatically for a linked project (visible in
# Settings, and auto-injected if you deploy via Nhost's own hosting).
# This app reads them directly — no separate HASURA_GRAPHQL_* set required.
NHOST_SUBDOMAIN=your-project-subdomain
NHOST_REGION=eu-central-1
NHOST_ADMIN_SECRET=changeme-generate-a-strong-secret
NHOST_GRAPHQL_URL=https://your-project-subdomain.hasura.eu-central-1.nhost.run/v1/graphql
NHOST_HASURA_URL=https://your-project-subdomain.hasura.eu-central-1.nhost.run
# ^ base Hasura URL, no /v1/graphql suffix — used by scripts/apply-migrations.mjs
#   and by the Hasura CLI (hasura/config.yaml) for metadata/console commands.

# ==== Nhost (frontend, public — same subdomain/region as above) ====
NEXT_PUBLIC_NHOST_SUBDOMAIN=your-project-subdomain
NEXT_PUBLIC_NHOST_REGION=eu-central-1

# ==== Optional fallback names (self-hosted Hasura not managed by Nhost) ====
# Only needed if you are NOT using Nhost — lib/hasura.ts checks
# NHOST_GRAPHQL_URL / NHOST_ADMIN_SECRET first and falls back to these.
# HASURA_GRAPHQL_ENDPOINT=
# HASURA_GRAPHQL_ADMIN_SECRET=

# No PostgreSQL connection string is required anywhere in this app.
# Every read/write goes through Hasura's GraphQL/admin API using
# NHOST_GRAPHQL_URL + NHOST_ADMIN_SECRET (see lib/hasura.ts), including
# schema migrations (scripts/apply-migrations.mjs uses Hasura's /v2/query
# SQL-execution endpoint, not a direct `pg` connection). Do not enable
# Nhost's "public database access" setting for this project — it is never
# needed.

# Shared secret between Hasura Actions/Event Triggers and this app's API
# routes, so /api/actions/* and /api/webhooks/notify can't be invoked by an
# arbitrary internet client pretending to be Hasura.
ACTION_SECRET=changeme-generate-a-strong-secret

# Base URL Hasura uses to reach this app's Action/Event handlers
# (e.g. your Vercel deployment URL, or an ngrok URL for local dev).
ACTION_BASE_URL=https://n8n-lite.vercel.app

# LLM provider (llm_call step) 
# If unset, llm_call runs in documented stub mode (see lib/llm.ts).
LLM_PROVIDER=groq
LLM_API_KEY=
LLM_MODEL=llama-3.1-8b-instant

#  notify step (optional) 
# If unset, notify runs in stub mode (logs instead of sending).
SLACK_WEBHOOK_URL=
